{
  "name": "@vx-oss/heroui-v2-system-rsc",
  "version": "3.0.0-beta.1",
  "description": "HeroUI system primitives compatibles with RSC imports",
  "keywords": [
    "system-rsc"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui-v2.git",
    "directory": "packages/core/system-rsc"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui-v2/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "@vx-oss/heroui-v2-theme": ">=2.5.0-beta.1"
  },
  "devDependencies": {
    "@vx-oss/heroui-v2-theme": "workspace:*",
    "@vx-oss/heroui-v2-react-utils": "workspace:*",
    "@vx-oss/heroui-v2-shared-utils": "workspace:*",
    "react": "18.3.0",
    "tailwind-variants": "3.2.2",
    "tailwind-merge": "3.4.0",
    "clean-package": "2.2.0"
  },
  "dependencies": {
    "@react-types/shared": "3.33.1"
  },
  "clean-package": "../../../clean-package.config.json",
  "tsup": {
    "clean": true,
    "target": "es2019",
    "format": [
      "cjs",
      "esm"
    ]
  }
}
