{
  "name": "@vx-oss/heroui-v2-progress",
  "version": "3.0.0-beta.1",
  "description": "Progress bars show either determinate or indeterminate progress of an operation over time.",
  "keywords": [
    "progress"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui-v2.git",
    "directory": "packages/components/progress"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui-v2/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "@vx-oss/heroui-v2-theme": ">=2.5.0-beta.1",
    "@vx-oss/heroui-v2-system": ">=2.5.0-beta.1"
  },
  "dependencies": {
    "@vx-oss/heroui-v2-shared-utils": "workspace:*",
    "@vx-oss/heroui-v2-react-utils": "workspace:*",
    "@vx-oss/heroui-v2-use-is-mounted": "workspace:*",
    "@react-aria/progress": "3.4.30",
    "@react-types/progress": "3.5.18"
  },
  "devDependencies": {
    "@vx-oss/heroui-v2-theme": "workspace:*",
    "@vx-oss/heroui-v2-system": "workspace:*",
    "@vx-oss/heroui-v2-card": "workspace:*",
    "@vx-oss/heroui-v2-chip": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
