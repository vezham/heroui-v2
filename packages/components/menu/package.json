    "@vx-oss/heroui-v2-system": ">=2.5.0-beta.1"
  },
  "dependencies": {
    "@vx-oss/heroui-v2-divider": "workspace:*",
    "@vx-oss/heroui-v2-aria-utils": "workspace:*",
    "@vx-oss/heroui-v2-use-is-mobile": "workspace:*",
    "@vx-oss/heroui-v2-shared-utils": "workspace:*",
    "@vx-oss/heroui-v2-react-utils": "workspace:*",
    "@react-aria/focus": "3.21.5",
    "@react-aria/interactions": "3.27.1",
    "@react-aria/menu": "3.21.0",
    "@react-stately/tree": "3.9.6",
    "@react-types/menu": "3.10.7",
    "@react-types/shared": "3.33.1"
  },
  "devDependencies": {
    "@vx-oss/heroui-v2-theme": "workspace:*",
    "@vx-oss/heroui-v2-system": "workspace:*",
    "@vx-oss/heroui-v2-shared-icons": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
