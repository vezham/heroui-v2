{
  "name": "@vx-oss/heroui-v2-chip",
  "version": "2.2.25",
  "description": "Chips help people enter information, make selections, filter content, or trigger actions.",
  "keywords": [
    "chip"
  ],
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "homepage": "https://vezham.com",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/heroui-v2.git",
    "directory": "packages/components/chip"
  },
  "bugs": {
    "url": "https://github.com/vezham/heroui-v2/issues"
  },
  "scripts": {
    "build": "tsup src --dts",
    "build:fast": "tsup src",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "peerDependencies": {
    "react": ">=18 || >=19.0.0-rc.0",
    "react-dom": ">=18 || >=19.0.0-rc.0",
    "@vx-oss/heroui-v2-theme": ">=2.4.24",
    "@vx-oss/heroui-v2-system": ">=2.4.18"
  },
  "dependencies": {
    "@vx-oss/heroui-v2-shared-icons": "workspace:*",
    "@vx-oss/heroui-v2-shared-utils": "workspace:*",
    "@vx-oss/heroui-v2-react-utils": "workspace:*",
    "@react-aria/focus": "3.21.5",
    "@react-aria/interactions": "3.27.1"
  },
  "devDependencies": {
    "@vx-oss/heroui-v2-theme": "workspace:*",
    "@vx-oss/heroui-v2-system": "workspace:*",
    "@vx-oss/heroui-v2-avatar": "workspace:*",
    "clean-package": "2.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "clean-package": "../../../clean-package.config.json"
}
